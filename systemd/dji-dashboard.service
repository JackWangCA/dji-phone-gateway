[Unit]
Description=DJI phone gateway web dashboard
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/dji-phone-gateway/gateway.env
ExecStart=/usr/bin/python3 /opt/dji-phone-gateway/src/web_dashboard.py
User=djigateway
Group=asterisk
Restart=on-failure
RestartSec=5
# This service uses sudo only for the exact commands allowed in
# /etc/sudoers.d/dji-phone-gateway.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dji-phone-gateway

[Install]
WantedBy=multi-user.target
