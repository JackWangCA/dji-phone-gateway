[Unit]
Description=DJI modem Telegram SMS bridge
After=network-online.target asterisk.service
Wants=network-online.target
Requires=asterisk.service

[Service]
Type=simple
EnvironmentFile=/etc/dji-phone-gateway/gateway.env
ExecCondition=/bin/sh -c '[ -n "${TELEGRAM_BOT_TOKEN:-}" ] || [ -s /var/lib/dji-phone-gateway/settings.json ]'
ExecStart=/usr/bin/python3 /opt/dji-phone-gateway/src/sms_bridge.py
User=djigateway
Group=asterisk
Restart=on-failure
RestartSec=5
# Telegram data controls use the same narrowly scoped sudoers rule.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dji-phone-gateway

[Install]
WantedBy=multi-user.target
