#!/bin/sh
set -eu

repository="@REPOSITORY@"
release_base="${DJI_GATEWAY_RELEASE_URL:-https://github.com/$repository/releases/latest/download}"
archive_name=dji-phone-gateway.tar.gz
checksum_name="$archive_name.sha256"

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this installer as root (pipe it to sudo sh)." >&2
    exit 1
fi

case "$(uname -m)" in
    aarch64|armv7l) ;;
    *) echo "DJI Phone Gateway supports Raspberry Pi ARM systems only." >&2; exit 1 ;;
esac

for command in curl sha256sum tar mktemp; do
    command -v "$command" >/dev/null 2>&1 || {
        echo "Missing required command: $command" >&2
        exit 1
    }
done

work_dir=$(mktemp -d /var/tmp/dji-gateway-release.XXXXXX)
trap 'rm -rf "$work_dir"' EXIT INT TERM

echo "Downloading the latest DJI Phone Gateway release..."
curl -fL --retry 3 "$release_base/$archive_name" -o "$work_dir/$archive_name"
curl -fL --retry 3 "$release_base/$checksum_name" -o "$work_dir/$checksum_name"

expected=$(awk 'NR == 1 {print $1}' "$work_dir/$checksum_name")
actual=$(sha256sum "$work_dir/$archive_name" | awk '{print $1}')
if [ -z "$expected" ] || [ "$actual" != "$expected" ]; then
    echo "Release checksum verification failed; nothing was installed." >&2
    exit 1
fi

mkdir "$work_dir/source"
tar -xzf "$work_dir/$archive_name" -C "$work_dir/source" --strip-components=1
test -x "$work_dir/source/install.sh" || {
    echo "The verified release does not contain install.sh." >&2
    exit 1
}

echo "Release verified. Starting the Raspberry Pi installer..."
"$work_dir/source/install.sh"
