#!/usr/bin/env python3
"""Store an incoming SMS and optionally forward it to Telegram via Asterisk AGI."""
import json
import os
import re
import sqlite3
import sys
import urllib.parse
import urllib.request


def friendly_sender(sender):
    """Format North American numbers for compact iOS notifications and speech."""
    value = str(sender or "").strip()
    digits = re.sub(r"\D", "", value)
    if len(digits) == 11 and digits.startswith("1"):
        return f"+1 ({digits[1:4]}) {digits[4:7]}-{digits[7:]}"
    if len(digits) == 10:
        return f"({digits[:3]}) {digits[3:6]}-{digits[6:]}"
    return value if value and value.lower() != "unknown" else "Unknown number"


def telegram_notification(sender, message):
    """Create a compact notification preview that is easy for Siri to announce."""
    body = str(message or "").strip() or "Empty message"
    return f"{friendly_sender(sender)}: {body}"


def save_reply_target(database, message_id, chat_id, sender):
    """Link a Telegram notification to the cellular number that sent it."""
    with sqlite3.connect(database) as db:
        db.execute(
            "CREATE TABLE IF NOT EXISTS telegram_reply_targets ("
            "message_id INTEGER NOT NULL, chat_id INTEGER NOT NULL, sender TEXT NOT NULL, "
            "created_at TEXT DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY(message_id, chat_id))"
        )
        db.execute(
            "INSERT OR REPLACE INTO telegram_reply_targets(message_id, chat_id, sender) VALUES (?, ?, ?)",
            (int(message_id), int(chat_id), sender),
        )


def ensure_message_schema(db):
    db.execute(
        "CREATE TABLE IF NOT EXISTS messages ("
        "id INTEGER PRIMARY KEY, received_at TEXT DEFAULT CURRENT_TIMESTAMP, "
        "sender TEXT NOT NULL, body TEXT NOT NULL, direction TEXT NOT NULL DEFAULT 'incoming')"
    )
    columns = {str(row[1]) for row in db.execute("PRAGMA table_info(messages)")}
    if "direction" not in columns:
        db.execute("ALTER TABLE messages ADD COLUMN direction TEXT NOT NULL DEFAULT 'incoming'")


def agi_variable(name):
    print(f"GET VARIABLE {name}", flush=True)
    response = sys.stdin.readline().strip()
    match = re.match(r"^200 result=1 \((.*)\)$", response)
    return match.group(1) if match else ""


def agi_verbose(message, level=1):
    safe = str(message).replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")
    print(f'VERBOSE "{safe}" {level}', flush=True)
    sys.stdin.readline()


def main():
    for line in sys.stdin:
        if not line.strip():
            break

    sender = agi_variable("CALLERID(num)") or "unknown"
    raw_sms = agi_variable("SMS")
    message = agi_variable("SMS_TEXT")
    if raw_sms:
        try:
            parsed_sms = json.loads(raw_sms)
            if isinstance(parsed_sms, dict):
                sender = str(parsed_sms.get("from") or sender)
                message = str(parsed_sms.get("msg") or message)
        except (json.JSONDecodeError, TypeError, ValueError):
            agi_verbose("DJI gateway: could not parse the inbound SMS payload", 2)

    token = os.environ.get("TELEGRAM_BOT_TOKEN", "")
    chat = os.environ.get("TELEGRAM_CHAT_ID", "")
    settings_path = os.environ.get("GATEWAY_SETTINGS", "/var/lib/dji-phone-gateway/settings.json")
    try:
        with open(settings_path, encoding="utf-8") as stream:
            settings = json.load(stream)
        token = str(settings.get("telegram_bot_token") or token)
        chat = str(settings.get("telegram_chat_id") or chat)
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        pass

    database = os.environ.get("SMS_DATABASE", "/var/lib/dji-phone-gateway/messages.sqlite3")
    try:
        with sqlite3.connect(database) as db:
            ensure_message_schema(db)
            db.execute(
                "INSERT INTO messages(sender, body, direction) VALUES (?, ?, 'incoming')",
                (sender, message),
            )
        # Asterisk owns newly created databases. Keep them writable by the
        # shared asterisk group used by the dashboard and Telegram bridge.
        try:
            os.chmod(database, 0o660)
        except OSError:
            # A database first created by the dashboard is owned by djigateway,
            # but its service umask already gives this shared group write access.
            pass
        agi_verbose(f"DJI gateway: stored inbound SMS from {sender}")
    except sqlite3.Error as exc:
        agi_verbose(f"DJI gateway: failed to store inbound SMS: {exc}", 3)
        raise SystemExit(1)

    if not token or not chat:
        agi_verbose("DJI gateway: Telegram is not configured; SMS stored locally")
        raise SystemExit(0)
    payload = urllib.parse.urlencode({"chat_id": chat, "text": telegram_notification(sender, message)}).encode()
    req = urllib.request.Request(f"https://api.telegram.org/bot{token}/sendMessage", data=payload)
    try:
        with urllib.request.urlopen(req, timeout=15) as response:
            telegram_result = json.load(response)
            if not telegram_result.get("ok"):
                raise RuntimeError("Telegram returned an error")
        telegram_message_id = telegram_result.get("result", {}).get("message_id")
        if telegram_message_id is not None:
            try:
                save_reply_target(database, telegram_message_id, chat, sender)
            except (sqlite3.Error, TypeError, ValueError) as exc:
                agi_verbose(f"DJI gateway: could not save Telegram reply target: {exc}", 2)
        agi_verbose(f"DJI gateway: forwarded inbound SMS from {sender} to Telegram")
    except (OSError, RuntimeError, json.JSONDecodeError) as exc:
        agi_verbose(f"DJI gateway: Telegram forwarding failed: {exc}", 2)
        raise SystemExit(1)


if __name__ == "__main__":
    if len(sys.argv) == 4 and sys.argv[1] == "--format-preview":
        print(telegram_notification(sys.argv[2], sys.argv[3]))
    else:
        main()
